package-lock=true
# BUG-3 修复：npm 内置安装脚本审批在安装时即读 .npmrc 的 allow-scripts[]，
# 批准并运行这 5 个包的 install scripts（消除 "allow-scripts not yet covered" 警告，
# 避免跨机移植时 unrs-resolver 等原生绑定 install script 被跳过致功能异常）。
# 注：package.json 的 config.allowScripts 仅声明意图（npm approve-scripts 期望位置），
# 实际生效以本处 allow-scripts[] 为准（安装前即生效，不受镜像覆盖 package-lock 影响）。
allow-scripts[]=@google/genai
allow-scripts[]=core-js
allow-scripts[]=protobufjs
allow-scripts[]=puppeteer
allow-scripts[]=unrs-resolver
