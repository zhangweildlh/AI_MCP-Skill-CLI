{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "<全局 bin 路径>/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
