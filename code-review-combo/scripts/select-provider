#!/usr/bin/env bash
# select-provider — Stage0 选择器（code-review-combo 多 Key 轮询）
#
# 设计（详见实施计划 §3.1）：
#   * 读取 ocr 配置中已配置的「自定义 provider」列表（config.json 的 custom_providers 键名）。
#   * `probe` 子命令**串行跑 `ocr llm test` 逐个探测**（首个成功即停，exit 0；全失败 exit 2），
#     命中即把该 provider 设为 ocr 全局激活 provider 供 Stage1 直接复用；探测失败的 provider
#     由 `probe` 阶段按 401/403→hard、429/超时→soft 写回两级 TTL 死 Key 缓存（不依赖 Stage1 回写）。
#     （`list` 子命令才是「仅按缓存过滤、不跑 ocr llm test、输出可用候选」的轻量查询。）
#   * 两级 TTL 死 Key 缓存（落盘于 combo 目录内 .ocr-provider-cache.json）：
#       - 硬失效（HTTP 401/403，Key 无效/被吊销）→ 长 TTL 拉黑 24h；
#       - 软不可用（HTTP 429 / 单日额度耗尽）→ 按次日 00:00 本地时间解禁。
#
# 接口约定：
#   select-provider              # 列出可用 provider（每行一个），exit 0；全死则 stdout 空 + exit 1
#   select-provider mark <P> hard|soft   # 标记某 provider 为死 Key 写回缓存
#   select-provider clear [<P>]  # 清除某 provider（或全量）的死 Key 标记
#   select-provider probe [-c <path>]    # 串行轮询探测可用 provider（成功 exit 0 / 全失败 exit 2）
#   select-provider -h|--help    # 帮助
#
# 依赖：node（ocr 即 node 装，环境自带）；禁止裸 python/pip。
# Key：优先读取本技能目录内 config/providers.json（相对路径），并同步至 ocr 运行时配置；
#      绝不打印任何 api_key 明文，仅处理 provider 名与 TTL。

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# 用 pwd -W 取得 Windows 绝对路径（如 D:/...），避免 Git Bash 的 /d/... 被 node 误判为相对盘根路径
COMBO_DIR="$(cd "$SCRIPT_DIR/.." && (pwd -W 2>/dev/null || pwd))"
CACHE_FILE="$COMBO_DIR/.ocr-provider-cache.json"

# ocr config 路径：Windows 下优先 USERPROFILE，否则回退 $HOME
CFG="$USERPROFILE/.opencodereview/config.json"
[ -f "$CFG" ] || CFG="$HOME/.opencodereview/config.json"
_cfgdir="$(dirname "$CFG")"
if [ -d "$_cfgdir" ]; then
  _cfgdir="$(cd "$_cfgdir" && (pwd -W 2>/dev/null || pwd))"
fi
CFG="$_cfgdir/$(basename "$CFG")"

# 技能本地 provider 配置（相对路径，优先级高于全局 ocr 配置）：
#   Key 外置于本技能目录 config/providers.json（由 config/providers.example.json 复制填充）。
#   任一 Agent 使用本技能时，select-provider 经相对路径读取该文件获得 provider 与 api_key 配置，
#   并将其 custom_providers 合并同步到 ocr 运行时配置（~/.opencodereview/config.json），
#   使后续的 `ocr review` / `ocr scan --provider <P>` 可直接调用 LLM。
SKILL_LOCAL="$COMBO_DIR/config/providers.json"
if [ -f "$SKILL_LOCAL" ]; then
  node -e "$(cat <<'NODE'
    const fs = require('fs');
    const local = process.argv[1];
    const ocrCfg = process.argv[2];
    let localJ;
    try { localJ = JSON.parse(fs.readFileSync(local, 'utf8')); }
    catch (e) { process.stderr.write('select-provider: 本地配置解析失败 ' + e.message + '\n'); process.exit(1); }
    const cp = (localJ && localJ.custom_providers) || {};
    if (Object.keys(cp).length === 0) {
      process.stderr.write('select-provider: 本地配置无 custom_providers，跳过同步\n');
      process.exit(0);
    }
    let ocrJ = {};
    try { ocrJ = JSON.parse(fs.readFileSync(ocrCfg, 'utf8')); } catch (e) { ocrJ = {}; }
    if (!ocrJ.custom_providers || typeof ocrJ.custom_providers !== 'object') ocrJ.custom_providers = {};
    const merged = JSON.stringify(ocrJ.custom_providers);
    const incoming = JSON.stringify(cp);
    if (merged !== incoming) {
      try { if (fs.existsSync(ocrCfg)) fs.copyFileSync(ocrCfg, ocrCfg + '.bak'); } catch (e) {}
      Object.assign(ocrJ.custom_providers, cp);
      fs.writeFileSync(ocrCfg, JSON.stringify(ocrJ, null, 2) + '\n');
      process.stderr.write('select-provider: 已将本地 custom_providers 同步至 ocr 配置 (' + Object.keys(cp).join(', ') + ')\n');
    } else {
      process.stderr.write('select-provider: 本地 custom_providers 与 ocr 配置一致，无需同步\n');
    }
    process.exit(0);
NODE
  )" "$SKILL_LOCAL" "$CFG"
  CFG="$SKILL_LOCAL"
fi

run_node() {
  node -e "$(cat <<'NODE'
    const fs = require('fs');
    const args = process.argv.slice(1); // node -e 下脚本不计入 argv，用户参数自 argv[1] 起
    const cmd = args[0];
    const cacheFile = args[1] || process.env.OCR_CACHE_FILE;
    const cfgFile = args[2] || process.env.OCR_CONFIG_FILE;

    const HOUR = 3600 * 1000;
    const DAY = 24 * HOUR;

    function nowMs() { return Date.now(); }
    function nextMidnight() {
      const d = new Date();
      d.setHours(24, 0, 0, 0); // 本地次日 00:00
      return d.getTime();
    }
    function loadCache() {
      try { return JSON.parse(fs.readFileSync(cacheFile, 'utf8')); }
      catch (e) { return {}; }
    }
    function saveCache(o) {
      fs.writeFileSync(cacheFile, JSON.stringify(o, null, 2) + '\n');
    }
    function loadProviders() {
      try {
        const j = JSON.parse(fs.readFileSync(cfgFile, 'utf8'));
        const cp = j && j.custom_providers;          // 关键：自定义 provider 在 custom_providers 字段
        if (cp && typeof cp === 'object') return Object.keys(cp);
      } catch (e) { /* 配置缺失/损坏 → 无候选 */ }
      return [];
    }

    if (cmd === 'list') {
      const providers = loadProviders();
      const cache = loadCache();
      const now = nowMs();
      const avail = [];
      const banned = [];
      for (const p of providers) {
        const c = cache[p];
        if (c && typeof c.until === 'number' && c.until > now) {
          banned.push(p + ' (' + (c.status || '?') + ', until ' + new Date(c.until).toISOString() + ')');
          continue;
        }
        avail.push(p);
      }
      if (avail.length) {
        process.stdout.write(avail.join('\n') + '\n');
        process.exit(0);
      }
      // 无可用候选 → 空 stdout，exit 1（调用方据此降级 delegate）
      if (banned.length) {
        process.stderr.write('select-provider: 全部 provider 处于死 Key 拉黑：' + banned.join(', ') + '\n');
      } else {
        process.stderr.write('select-provider: 未在 config.json 的 custom_providers 中发现任何已配置 provider\n');
      }
      process.exit(1);
    } else if (cmd === 'mark') {
      const provider = args[3];
      const kind = args[4] === 'hard' ? 'hard' : 'soft';
      if (!provider) { process.stderr.write('用法: select-provider mark <provider> hard|soft\n'); process.exit(2); }
      const cache = loadCache();
      const now = nowMs();
      const until = kind === 'hard' ? now + DAY : nextMidnight();
      cache[provider] = { status: kind, until: until, marked_at: now };
      saveCache(cache);
      process.stderr.write('select-provider: 已将 ' + provider + ' 标记为 ' + kind +
        '（解禁时间 ' + new Date(until).toLocaleString() + '）\n');
      process.exit(0);
    } else if (cmd === 'clear') {
      const provider = args[3];
      let cache = loadCache();
      if (provider) { delete cache[provider]; process.stderr.write('select-provider: 已清除 ' + provider + ' 的死 Key 标记\n'); }
      else { cache = {}; process.stderr.write('select-provider: 已清除全部死 Key 标记\n'); }
      saveCache(cache);
      process.exit(0);
    } else {
      process.stderr.write('select-provider: 未知子命令 ' + String(cmd) + '\n');
      process.exit(2);
    }
NODE
)" "$@"
}

# to_win — 将 Git Bash 风格路径（如 /tmp/x、/d/x）转为 Windows 绝对路径（D:/...），
#          供 node（Windows 原生）直接读取（与顶部 COMBO_DIR 的 pwd -W 处理一致）
to_win() {
  local p="$1"
  local d
  d="$(cd "$(dirname "$p")" && (pwd -W 2>/dev/null || pwd))"
  echo "$d/$(basename "$p")"
}

# cmd_probe — 串行轮询探测各自定义 provider 是否可用（复用两级 TTL 缓存）
#   调用: bash ./scripts/select-provider probe [-c <config_path>]
#   配置: 默认 <combo>/config/providers.json；-c/--config 指定则优先
#   成功: 打印一行 JSON {"ok":true,"provider","model","url","latency_ms"} 并 exit 0（停止轮询）
#   全失败: 打印 {"ok":false,"all_failed":true,"results":[...]} 并 exit 2
#   失败分类: 401/403→mark hard（拉黑24h）；429/超时→mark soft（次日00:00解禁）
#   注意: ocr config set provider 改全局配置，故必须串行；轮询结束还原原激活 provider
cmd_probe() {
  shift   # 去掉 "probe" 自身
  local PROBE_CFG="$SKILL_LOCAL"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--config) PROBE_CFG="${2:-}"; shift 2;;
      *) shift;;
    esac
  done

  if [ ! -f "$PROBE_CFG" ]; then
    echo "{\"ok\":false,\"error\":\"config not found: $PROBE_CFG\"}" >&2
    exit 2
  fi

  # 按顺序输出 provider 键名（node 保留对象插入顺序）
  local providers
  providers="$(node -e "$(cat <<'NODE'
    const fs=require('fs');
    let j; try { j=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); } catch (e) { process.exit(0); }
    const cp=(j&&j.custom_providers)||{};
    process.stdout.write(Object.keys(cp).join('\n'));
NODE
  )" "$PROBE_CFG")"

  if [ -z "$providers" ]; then
    echo "{\"ok\":false,\"error\":\"no custom_providers found in $PROBE_CFG\"}" >&2
    exit 2
  fi

  # 轮询前记录原激活 provider（循环结束还原）
  local orig=""
  orig="$(ocr config get provider 2>/dev/null || true)"

  local results_file
  results_file="$(to_win "$(mktemp)")"
  local found=0
  local ok_p="" ok_model="" ok_url="" ok_latency=""

  local OLDIFS="$IFS"
  IFS=$'\n'
  for P in $providers; do
    [ -z "$P" ] && continue
    # 设置当前 provider（全局配置生效，故必须串行轮询）
    ocr config set provider "$P" >/dev/null 2>&1 || true

    local start end out ec latency tmpout kind err parsed
    start="$(date +%s%3N)"
    set +e
    out="$(timeout 30 ocr llm test 2>&1)"
    ec=$?
    set -e
    end="$(date +%s%3N)"
    latency=$((end - start))

    # 成功判定: exit 0 且 stdout 含成功标记
    if [ "$ec" -eq 0 ] && printf '%s' "$out" | grep -q 'Connection test successful'; then
      tmpout="$(to_win "$(mktemp)")"
      printf '%s' "$out" > "$tmpout"
      # 优先从 ocr llm test 输出解析 Model/URL，缺失则回退到配置
      parsed="$(node -e "$(cat <<'NODE'
        const fs=require('fs');
        let out=''; try { out=fs.readFileSync(process.argv[1],'utf8'); } catch (e) {}
        const cfg=process.argv[2], P=process.argv[3];
        let m='', u='';
        const lm=out.match(/Model:\s*(.+)/i); if (lm) m=lm[1].trim();
        const lu=out.match(/URL:\s*(.+)/i);   if (lu) u=lu[1].trim();
        try {
          const j=JSON.parse(fs.readFileSync(cfg,'utf8'));
          const cp=(j&&j.custom_providers)||{}; const e=cp[P]||{};
          if (!m && e.model) m=e.model;
          if (!u && e.url)   u=e.url;
        } catch (e) {}
        process.stdout.write((m||'')+'\n'+(u||'')+'\n');
NODE
      )" "$tmpout" "$PROBE_CFG" "$P")" || parsed=$'\n'
      rm -f "$tmpout"
      ok_model="$(printf '%s' "$parsed" | sed -n '1p')"
      ok_url="$(printf '%s' "$parsed" | sed -n '2p')"
      ok_p="$P"; ok_latency="$latency"; found=1
      break
    fi

    # 失败分类 → 对应 mark（401/403=hard，429/超时=soft），继续下一个
    kind=soft; err="llm test failed (exit $ec)"
    if [ "$ec" -eq 124 ]; then
      kind=soft; err="timeout after 30s"
    elif printf '%s' "$out" | grep -qiE '401|unauthorized'; then
      kind=hard; err="auth failed (401)"
    elif printf '%s' "$out" | grep -qiE '403|forbidden'; then
      kind=hard; err="auth failed (403)"
    elif printf '%s' "$out" | grep -qiE '429|rate.?limit'; then
      kind=soft; err="rate limited (429)"
    elif printf '%s' "$out" | grep -qiE 'timed out|timeout|ETIMEDOUT'; then
      kind=soft; err="timeout"
    fi
    # 复用既有 mark 两级 TTL 缓存函数（写盘 .ocr-provider-cache.json）
    run_node mark "$CACHE_FILE" "$PROBE_CFG" "$P" "$kind" || true

    # 记录失败结果（node 转义，保证 JSON 干净）
    node -e "process.stdout.write(JSON.stringify({provider:process.argv[1],error:process.argv[2]}))" "$P" "$err" >> "$results_file"
    printf '\n' >> "$results_file"
  done
  IFS="$OLDIFS"

  # 还原全局 provider 配置（原激活为空则跳过）
  if [ -n "$orig" ]; then ocr config set provider "$orig" >/dev/null 2>&1 || true; fi

  if [ "$found" -eq 1 ]; then
    node -e "process.stdout.write(JSON.stringify({ok:true,provider:process.argv[1],model:process.argv[2],url:process.argv[3],latency_ms:Number(process.argv[4])}))" "$ok_p" "$ok_model" "$ok_url" "$ok_latency"
    exit 0
  fi

  # 全部失败: 汇总结果（node 组装，保证合法 JSON）
  local final
  final="$(node -e "$(cat <<'NODE'
    const fs=require('fs');
    const lines=fs.readFileSync(process.argv[1],'utf8').split('\n').filter(Boolean);
    const arr=lines.map(l=>{ try { return JSON.parse(l); } catch (e) { return null; } }).filter(Boolean);
    process.stdout.write(JSON.stringify({ok:false,all_failed:true,results:arr}));
NODE
  )" "$results_file")"
  rm -f "$results_file"
  echo "$final"
  exit 2
}

case "${1:-}" in
  ""|list|--list)
    run_node list "$CACHE_FILE" "$CFG"
    ;;
  mark)
    run_node mark "$CACHE_FILE" "$CFG" "${2:-}" "${3:-}"
    ;;
  clear)
    run_node clear "$CACHE_FILE" "$CFG" "${2:-}"
    ;;
  probe)
    cmd_probe "$@"
    ;;
  -h|--help|help)
    cat <<'USAGE'
select-provider — code-review-combo Stage0 选择器

用法:
  select-provider                 列出可用 provider（每行一个，exit 0）；全死则空 stdout + exit 1
  select-provider mark <P> hard|soft   标记 <P> 为死 Key（hard=401/403 拉黑24h，soft=429 次日00:00解禁）
  select-provider clear [<P>]    清除死 Key 标记（省略 <P> 则清除全部）
  select-provider probe [-c <path>]  串行轮询探测可用 provider；命中打印 {"ok":true,...} 并 exit 0，全失败打印 {"ok":false,"all_failed":true,...} 并 exit 2
  select-provider -h|--help      显示本帮助

缓存文件: <combo>/.ocr-provider-cache.json（两级 TTL 死 Key 缓存，由 Stage1 实跑失败写回）
USAGE
    exit 0
    ;;
  *)
    echo "select-provider: 未知参数 '$1'（用 -h 查看帮助）" >&2
    exit 2
    ;;
esac
